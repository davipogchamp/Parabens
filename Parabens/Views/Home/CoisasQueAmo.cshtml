@{
    ViewData["Title"] = "Coisas que Amo em Você ❤️";
}

<link rel="stylesheet" href="~/css/coisas-que-amo.css" />

<nav class="navbar">

    <div class="logo">
        ❤️ D & N
    </div>

    <ul class="nav-links">

        <li><a asp-controller="Home" asp-action="Home">Início</a></li>

        <li><a asp-controller="Home" asp-action="_TimeLine">Nossa História</a></li>

        <li><a class="" asp-controller="Home" asp-action="CoisasQueAmo">Coisas Que Amo</a></li>

        <li><a asp-controller="Home" asp-action="Carta">Carta</a></li>

        <li><a href="#playlist">Playlist</a></li>

    </ul>

</nav>
<section class="love-page">

    <!-- Fundo mágico -->
    <div class="stars"></div>

    <div class="love-container">

        <!-- CABEÇALHO -->

        <header class="love-header">

            <span class="small-title">
                PARA VOCÊ
            </span>

            <h1>
                Coisas que amo
                <span>em você</span>
            </h1>

            <p>
                Existem coisas que talvez eu nunca consiga
                explicar completamente...
                mas tentei guardar algumas delas aqui.
            </p>

        </header>


        <!-- CARTAS -->

        <div class="love-grid">


            <!-- CARTA 1 -->

            <button class="love-card">

                <div class="card-front">

                    <span class="number">
                        01
                    </span>

                    <span class="card-heart">
                        ♡
                    </span>

                    <h2>
                        Seu sorriso
                    </h2>

                    <span class="open-text">
                        toque para descobrir
                    </span>

                </div>


                <div class="card-back">

                    <span>01</span>

                    <p>
                        Seu sorriso tem um jeito inexplicável
                        de deixar qualquer momento melhor.
                        Acho que você nem percebe o efeito
                        que ele tem em mim.
                    </p>

                    <strong>
                        ❤️
                    </strong>

                </div>

            </button>


            <!-- CARTA 2 -->

            <button class="love-card">

                <div class="card-front">

                    <span class="number">
                        02
                    </span>

                    <span class="card-heart">
                        ♡
                    </span>

                    <h2>
                        Seu jeito
                    </h2>

                    <span class="open-text">
                        toque para descobrir
                    </span>

                </div>


                <div class="card-back">

                    <span>02</span>

                    <p>
                        Amo o seu jeito de ser, até aquelas
                        pequenas manias que às vezes você
                        nem gosta em si mesma.
                    </p>

                    <strong>
                        ❤️
                    </strong>

                </div>

            </button>


            <!-- CARTA 3 -->

            <button class="love-card">

                <div class="card-front">

                    <span class="number">
                        03
                    </span>

                    <span class="card-heart">
                        ♡
                    </span>

                    <h2>
                        Seu abraço
                    </h2>

                    <span class="open-text">
                        toque para descobrir
                    </span>

                </div>


                <div class="card-back">

                    <span>03</span>

                    <p>
                        Tem alguma coisa no seu abraço que
                        faz o mundo parecer um pouco mais
                        tranquilo.
                    </p>

                    <strong>
                        ❤️
                    </strong>

                </div>

            </button>


            <!-- CARTA 4 -->

            <button class="love-card">

                <div class="card-front">

                    <span class="number">
                        04
                    </span>

                    <span class="card-heart">
                        ♡
                    </span>

                    <h2>
                        Nossas conversas
                    </h2>

                    <span class="open-text">
                        toque para descobrir
                    </span>

                </div>


                <div class="card-back">

                    <span>04</span>

                    <p>
                        Amo poder conversar com você sobre
                        qualquer coisa e perceber que as horas
                        simplesmente desaparecem.
                    </p>

                    <strong>
                        ❤️
                    </strong>

                </div>

            </button>


            <!-- CARTA 5 -->

            <button class="love-card">

                <div class="card-front">

                    <span class="number">
                        05
                    </span>

                    <span class="card-heart">
                        ♡
                    </span>

                    <h2>
                        Seu carinho
                    </h2>

                    <span class="open-text">
                        toque para descobrir
                    </span>

                </div>


                <div class="card-back">

                    <span>05</span>

                    <p>
                        Amo cada demonstração de carinho,
                        principalmente aquelas pequenas que
                        provavelmente você nem percebe.
                    </p>

                    <strong>
                        ❤️
                    </strong>

                </div>

            </button>


            <!-- CARTA 6 -->

            <button class="love-card">

                <div class="card-front">

                    <span class="number">
                        06
                    </span>

                    <span class="card-heart">
                        ♡
                    </span>

                    <h2>
                        Você
                    </h2>

                    <span class="open-text">
                        toque para descobrir
                    </span>

                </div>


                <div class="card-back">

                    <span>06</span>

                    <p>
                        No fim das contas, talvez seja
                        impossível escolher apenas uma coisa.
                        Eu amo simplesmente você.
                    </p>

                    <strong>
                        ❤️
                    </strong>

                </div>

            </button>


        </div>


        <!-- FINAL -->

        <div class="love-final">

            <div class="final-line"></div>

            <span>e poderia continuar...</span>

            <h2>
                Porque existem infinitas
                <em>coisas</em> para amar em você.
            </h2>

            <div class="final-heart">
                ♥
            </div>

        </div>

    </div>

</section>

<script src="~/js/coisas-que-amo.js"></script>