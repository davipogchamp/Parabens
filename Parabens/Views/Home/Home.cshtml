@{
    ViewData["Title"] = "Tenho muita sorte de te conhecer ❤️";
}

<section class="hero">

    <div class="overlay"></div>

    <div class="hero-content">

        <span class="tag">
            ❤️ Para o amor da minha vida
        </span>

        <h1>
            Feliz Aniversário,
            <br />
            Meu Amor.
        </h1>

        <p>
            Eu queria te dar um presente que durasse mais. 
            <br />
            A ideia desse site é ser pra sempre, continuar atualizando ele pra sempre!
            <br/>
            Espero que você goste❤️
        </p>

        <a href="#cards" class="btn">
            Começar nossa história
        </a>

    </div>

</section>

<section id="cards" class="cards">
<a class="" asp-controller="Home" asp-action="_Timeline">
    <div class="card">

        <div class="emoji">📖</div>

        <h2>Nossa História</h2>

        <p>
            Alguns capítulos da nossa caminhada até o momento.
        </p>

    </div>
</a>

    <div class="card">
        <a class="" asp-controller="Home" asp-action="CoisasQueAmo"> 
        <div class="emoji">💟</div>

        <h2>Coisas que Amo </h2>

        <p>
            Algumas coisas que eu amo em você.
        </p>
        </a>
    </div>

    <div class="card">
<a class="" asp-controller="Home" asp-action="Carta">
        <div class="emoji">💌</div>

        <h2>Carta</h2>

        <p>
            Algumas palavras merecem ficar guardadas.
        </p>
        </a>
    </div>

</section>