@{
    ViewData["Title"] = "Nossa História ❤️";
}

<section class="hero">

    <div class="overlay"></div>

    <div class="hero-content">

        <span class="tag">
            ❤️ Para o amor da minha vida
        </span>

        <h1>
            Feliz Aniversário,
            <br>
            Meu Amor.
        </h1>

        <p>
            Existem presentes que acabam com o tempo.
            Eu quis criar um lugar onde cada lembrança nossa
            pudesse viver para sempre.
        </p>

        <a href="#cards" class="btn">
            Começar nossa história
        </a>

    </div>

</section>

<section id="cards" class="cards">

    <div class="card">

        <div class="emoji">📖</div>

        <h2>Nossa História</h2>

        <p>
            Cada capítulo da nossa caminhada.
        </p>

    </div>

    <div class="card">

        <div class="emoji">📸</div>

        <h2>Álbum</h2>

        <p>
            Os momentos que jamais quero esquecer.
        </p>

    </div>

    <div class="card">

        <div class="emoji">💌</div>

        <h2>Cartas</h2>

        <p>
            Algumas palavras merecem ficar guardadas.
        </p>

    </div>

    <div class="card">

        <div class="emoji">🎵</div>

        <h2>Playlist</h2>

        <p>
            A trilha sonora da nossa história.
        </p>

    </div>

</section>