@{
    ViewData["Title"] = "Uma Carta Para Você ❤️";
}

<link rel="stylesheet" href="~/css/carta.css" />

<section class="carta-page">

    <div class="carta">

        <div class="carta-topo">
            <span>❤️</span>
            <p>Para o amor da minha vida</p>
        </div>

        <div class="linha"></div>

        <h1>Uma carta para você</h1>

        <div class="texto">

            <p>
                Meu amor,
            </p>

            <p>
                Hoje eu queria tirar um momento para escrever
                algumas palavras para você.
            </p>

            <p>
                Você pode escrever aqui tudo aquilo que sente,
                lembrar momentos especiais de vocês e dizer
                o quanto ela é importante para você.
            </p>

            <p>
                Obrigado por todos os momentos que vivemos juntos.
                Espero que ainda possamos criar muitas outras
                lembranças e continuar escrevendo nossa história.
            </p>

            <p>
                Feliz aniversário, meu amor. ❤️
            </p>

        </div>

        <div class="assinatura">

            <p>Com todo meu amor,</p>

            <strong>Davi ❤️</strong>

        </div>

    </div>

</section>